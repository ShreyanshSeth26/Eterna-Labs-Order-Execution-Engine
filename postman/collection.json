          { "key": "content-type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "demo-123" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"type\":\"market\",\"baseMint\":\"So111...\",\"quoteMint\":\"USDC...\",\"side\":\"buy\",\"amountIn\":0.5}"
        },
        "url": "http://localhost:3000/api/orders/execute"
      }
    },
    {
      "name": "WS Status (connect)",
      "request": { "method": "GET", "url": "ws://localhost:3000/api/orders/execute?orderId={{orderId}}" }
    }
  ],
  "variable": [{ "key": "orderId", "value": "" }]
}
